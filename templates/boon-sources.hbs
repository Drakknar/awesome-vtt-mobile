{{!-- SotDL 6.1.14: where the roll's boons and banes come from (core sourceRows); tap one to leave it out.
     Used as {{> avttmBoonSources action="promptSource"}} (prompts) or action="useSource" (the use dialog). --}}
<fieldset class="avttm-boon-sources">
  <legend>{{localize "AVTTC.Boons.sources"}}</legend>
  {{#each sources}}
  <button type="button" data-action="{{../action}}" data-source-id="{{id}}" role="checkbox"
          aria-checked="{{#if enabled}}true{{else}}false{{/if}}" class="avttm-wide {{#if enabled}}selected{{/if}}"
          aria-label="{{localize 'AVTTC.Boons.sourceToggle'}}: {{value}} {{label}}">
    <i class="fa-regular {{#if enabled}}fa-square-check{{else}}fa-square{{/if}}" inert></i> <b>{{value}}</b> {{label}}
  </button>
  {{/each}}
</fieldset>
